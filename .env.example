# 仅示例，真实值请填在界面设置里或复制为 .env
BILINOTES_HOST=127.0.0.1
BILINOTES_PORT=8765

# 转写档位：tiny / base / small / medium
BILINOTES_ASR_MODEL=small

# 转写语种：auto（采样自动检测）/ zh / en / ja / ko 等
BILINOTES_ASR_LANGUAGE=auto

# 模型供应商（key 请通过界面填写，会走 DPAPI 加密，不要写在这里）
BILINOTES_LLM_PROVIDER=deepseek

# 每篇笔记最多保留的画面张数
BILINOTES_MAX_FRAMES_TOTAL=40

# 处理完成后如何处置下载的视频/音频（体积大头，一条 17 分钟视频约 70MB）
# media = 只删视频和音频（默认）；all = 连抽帧和中间 json 一起删；keep = 全部保留
BILINOTES_CACHE_POLICY=media

# 转录润色（需已配置模型 Key 才生效）
# 智能标点：给转录补全/修正断句符号
BILINOTES_POLISH_PUNCTUATION=true
# 外语译中：非中文转录每行加一句中文译文（一行原文一行中文）
BILINOTES_BILINGUAL_TRANSCRIPT=true
# 画面解读：给每张关键帧配一句小结（结合讲解+画面文字），不再平铺 OCR
BILINOTES_FRAME_CAPTIONS=true

# 画面切换检测灵敏度：数值越小越敏感（4-40）
BILINOTES_SCENE_PHASH_DISTANCE=14

# 旅行类视频自动生成「行程路线」（地点顺序+交通+花费）
BILINOTES_TRAVEL_ITINERARY=true

# 看图模型（可选）：让画面解读直接"看"关键帧。填服务商 id：zhipu / qwen / moonshot / openai / ollama / custom
# Key 复用上方对应服务商的 Key（文字模型不必切过去）。DeepSeek 无视觉模型
# BILINOTES_VISION_PROVIDER=zhipu
# 仅 custom 时需要：
# BILINOTES_VISION_BASE_URL=
# BILINOTES_VISION_MODEL=
